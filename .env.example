# Copy to .env and fill in values (never commit .env)

# ─── Vite client (required for app boot) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only — OpenRouter fallback when qwen-proxy is unavailable locally
VITE_OPENROUTER_API_KEY=

# ─── Vercel serverless (api/*) — not prefixed with VITE_ ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
APP_BASE_URL=http://localhost:5173
